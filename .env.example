# --- Site ------------------------------------------------------------------
# Absolute origin, no trailing slash. Used for canonical URLs, the sitemap,
# OG image resolution and the links inside emails.
NEXT_PUBLIC_SITE_URL=https://bloodoc.life

# --- Supabase --------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Bypasses RLS — never prefix this NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# --- ZeptoMail -------------------------------------------------------------
# The full header value, including the scheme: "Zoho-enczapikey <token>".
ZEPTOMAIL_TOKEN=
ZEPTOMAIL_API_URL=https://api.zeptomail.in/v1.1/email
MAIL_FROM=noreply@bloodoc.life
MAIL_FROM_NAME=BlooDoc

# --- Assistant (optional) --------------------------------------------------
# Any OpenAI-compatible chat-completions endpoint. Left blank, the console's
# assistant renders a "not configured" state instead of failing.
#
# SARVAM_SYSTEM_MESSAGE is deliberately ignored: the assistant's instructions
# carry medical-safety rules and live in src/lib/ai/chat.ts, not in an env var.
SARVAM_API_KEY=
SARVAM_BASE_URL=https://api.sarvam.ai/v1
SARVAM_MODEL_ID=sarvam-105b
SARVAM_TEMPERATURE=0.4
SARVAM_TOP_P=1
SARVAM_MAX_TOKENS=6000
# Thinking mode: low | medium | high, or `off`. `sarvam-105b` is the reasoning
# model and streams its working-out as `reasoning_content`, which is what the
# assistant's "Thinking…" disclosure shows. `sarvam-105b-conversations` never
# reports any, so the disclosure simply never appears on it.
SARVAM_REASONING_EFFORT=high
